rules_version = '2';
// Live since 2026-11-09. Closes the public list of orders.
// Customers never set status or the Drive folder: the operator does.
// Consequence: legacy 4-digit order IDs can no longer be created or read by customers,
// so the v2 page and /p/{no} previews stop working for new orders once this is live.
service cloud.firestore {
  match /databases/{database}/documents {
    function op() {
      return request.auth != null
        // The operator account (it also owns the Apps Script getsite-operator).
        && request.auth.token.email == 'getsite.yours@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function s(v, n) { return v is string && v.size() <= n; }

    function validCreate(d) {
      return d.keys().hasOnly(['siteName','purpose','email','name','sample','sections','sectionsDelegated',
          'sectionRequirement','galleryLayout','galleryRequirement','materials','driveFolderUrl','estimate',
          'status','summary','schema','displayNo','catalogVersion','brief','briefStatus','createdAt'])
        && d.keys().hasAll(['siteName','email','status','createdAt','displayNo','catalogVersion','brief','briefStatus'])
        && s(d.siteName, 60) && s(d.email, 120)
        && d.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')
        && s(d.get('purpose', ''), 300) && s(d.get('name', ''), 40)
        && s(d.get('sample', ''), 200) && s(d.get('summary', ''), 200)
        && s(d.get('galleryLayout', ''), 20) && s(d.get('galleryRequirement', ''), 100)
        && s(d.get('sectionRequirement', ''), 100) && s(d.get('materials', ''), 100)
        && s(d.get('estimate', ''), 60)
        && d.get('sections', []) is list && d.get('sections', []).size() <= 13
        && d.driveFolderUrl == ''
        && d.status == '샘플 제작 대기'
        && d.get('schema', 'v3') == 'v3'
        && d.displayNo is string && d.displayNo.matches('^WO-[0-9]{4}-[0-9]{4}$')
        && d.catalogVersion is string && d.catalogVersion.matches('^[0-9]{4}-[0-9]{2}-v[0-9]{1,3}$')
        && d.brief is map
        && d.brief.keys().hasOnly(['schema','catalogVersion','order','delivery','concept','hero','gallery','sections','references','sampleScope','customerText'])
        && d.briefStatus == 'pending'
        && d.createdAt == request.time;
    }


    function ref(v) { return v is string && (v == '' || (v.size() <= 300 && v.matches('^https://[A-Za-z0-9.-]+[.][A-Za-z]{2,}(:[0-9]{1,5})?(/[^\\s`<>]{0,270})?$'))); }
    // One pick per chosen section (gallery excluded) as one string: '<ref>|<by>|<keep csv>|<note>'
    // (v4/parts.js encodePick). One regex per section: a map per section with field checks went past
    // the 1000-expression request limit with all 13 sections (measured in the emulator).
    // The note is the tail, at most 300 characters, line breaks allowed.
    function pk(m, id) {
      return !(id in m) || m[id].matches('^(new[|](auto|user)[|]|[a-z0-9-]{1,40}:[A-Za-z0-9_-]{1,40}[|](auto|user)[|](layout|mood|content|layout,mood|layout,content|mood,content|layout,mood,content)?)[|](?s:.{0,300})$');
    }
    function validV4(d) {
      let keys = ['schema','displayNo','catalogVersion','email','siteName','oneLiner','name','topic','sampleId','sections','galleryLayout','ref1','ref2','ref3','materials','estimate','status','briefStatus','opMail','custMail','driveFolderUrl','createdAt','brief','picks','galleryNote','partsVersion'];
      let b = d.brief;
      let picks = d.picks;
      return d.keys().toSet() == keys.toSet()
        && d.schema == 'v4' && s(d.catalogVersion,40)
        && s(d.email,120) && d.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && s(d.siteName,80) && s(d.oneLiner,200) && s(d.name,40)
        && d.topic in ['artist','product','studio','class','place','motion'] && d.sampleId in ['artist','hansakim','nooreemadang','haru','soap','cup','cup3d','portfolio','portfolio-react','daol','cafe','gallery-layouts','hero-stack-fan','motion-1','motion-2']
        && d.sections is list && d.sections.size() >= 1 && d.sections.size() <= 13
        && d.sections.toSet().size() == d.sections.size() && d.sections.toSet().hasOnly(['hero','about','story','gallery','featured','history','process','services','trust','faq','contact','booking','newsletter'])
        && d.picks is map && d.picks.keys().toSet() == d.sections.toSet().difference(['gallery'].toSet())
        && pk(picks,'hero') && pk(picks,'about') && pk(picks,'story') && pk(picks,'featured')
        && pk(picks,'history') && pk(picks,'process') && pk(picks,'services') && pk(picks,'trust')
        && pk(picks,'faq') && pk(picks,'contact') && pk(picks,'booking') && pk(picks,'newsletter')
        && s(d.galleryNote,300) && s(d.partsVersion,20)
        && d.galleryLayout in ['auto','focus','film','masonry','index','grid','strip','flow','timeline','coverflow','stack','museum','peek','autoplay','drag','thumbnav']
        && ref(d.ref1) && ref(d.ref2) && ref(d.ref3) && d.materials in ['have','none']
        && d.estimate is map && d.estimate.keys().hasAll(['pages','video','revisions','total']) && d.estimate.keys().hasOnly(['pages','video','revisions','total'])
        && d.estimate.pages is int && d.estimate.pages >= 0 && d.estimate.pages <= 20
        && d.estimate.revisions is int && d.estimate.revisions >= 0 && d.estimate.revisions <= 20
        && d.estimate.video is bool && d.estimate.total is int
        && d.status == '샘플 제작 대기' && d.briefStatus == 'pending' && d.opMail == 'pending' && d.custMail == 'pending'
        && d.driveFolderUrl == ''
        && d.displayNo is string && d.displayNo.matches('^WO-[0-9]{4}-[0-9]{4}$') && d.createdAt == request.time
        && b is map && b.keys().hasAll(['schema','catalogVersion','order','delivery','sample','sections','gallery','references','sampleScope','customerText'])
        && b.keys().hasOnly(['schema','catalogVersion','order','delivery','sample','sections','gallery','references','sampleScope','customerText'])
        && b.schema == 'getsite.brief.v2'
        && b.customerText is map && s(b.customerText.get('siteName', ''), 80) && s(b.customerText.get('oneLiner', ''), 200) && s(b.customerText.get('name', ''), 40)
        && b.sections is list && b.sections.size() <= 13
        && b.references is map && b.references.get('customerLinks', []) is list && b.references.get('customerLinks', []).size() <= 3
        && b.sample is map && b.sample.keys().hasOnly(['id','title','topic','url']) && s(b.sample.get('title', ''), 120) && s(b.sample.get('url', ''), 300)
        && b.gallery is map && b.gallery.keys().hasOnly(['layoutId','name']) && s(b.gallery.get('name', ''), 40)
        && b.delivery is map && b.delivery.keys().hasOnly(['email']) && b.order is map && b.order.keys().hasOnly(['displayNo','createdAt'])
        && s(b.catalogVersion, 40) && b.sampleScope is map && b.sampleScope.size() <= 10;
    }

    function paid() {
      return resource.data.status in ['결제 완료', '제작 중', '수정 중', '납품 완료'];
    }
    function req(m, k) { return s(m.get(k, ''), 2000); }
    function validRequests(m) {
      return m is map
        && m.keys().hasOnly(['hero','about','story','gallery','featured','history','process','services','trust','faq','contact','booking','newsletter'])
        && req(m,'hero') && req(m,'about') && req(m,'story') && req(m,'gallery')
        && req(m,'featured') && req(m,'trust') && req(m,'faq') && req(m,'booking') && req(m,'newsletter')
        && req(m,'history') && req(m,'process') && req(m,'services') && req(m,'contact');
    }
    // After payment the customer may only write section requests, which flags them for the Drive sync.
    function customerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return paid()
        && changed.hasOnly(['sectionRequests','detailSubmittedAt','sectionStatus'])
        && validRequests(request.resource.data.sectionRequests)
        && request.resource.data.detailSubmittedAt == request.time
        && request.resource.data.sectionStatus == 'pending';
    }

    match /orders/{no} {
      allow get: if no.size() >= 24 || op();
      allow list, delete: if op();
      allow create: if no.matches('^WO-[0-9]{4}-[0-9]{4}-[A-Za-z0-9]{20}$')
        && (request.resource.data.get('schema', 'v3') == 'v4' ? validV4(request.resource.data) : validCreate(request.resource.data))
        && no.matches('^' + request.resource.data.displayNo + '-[A-Za-z0-9]{20}$');
      allow update: if op() || customerUpdate();
    }
    match /config/drive { allow get: if true; allow write: if op(); }
    match /{path=**} {
      allow read, write: if op();
    }
  }
}
