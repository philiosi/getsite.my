{
  "firestore": {
    "rules": "v3/backend/firestore.rules"
  },
  "hosting": {
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "public",
    "site": "getsite-my",
    "rewrites": [
      {
        "source": "/p/**",
        "destination": "/p.html"
      }
    ]
  },
  "storage": {
    "rules": "v3/backend/storage.rules"
  }
}
