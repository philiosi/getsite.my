{
  "firestore": {
    "rules": "v3/backend/firestore.rules"
  },
  "hosting": {
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "public",
    "redirects": [
      {
        "source": "/p/**",
        "destination": "/",
        "type": 301
      }
    ],
    "site": "getsite-my"
  },
  "storage": {
    "rules": "v3/backend/storage.rules"
  }
}
